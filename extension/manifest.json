{
  "manifest_version": 3,
  "name": "NavHub 收藏助手",
  "version": "1.0.0",
  "description": "一键收藏当前网页到 NavHub，AI 自动分类",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["*://nav.example.com/*", "http://localhost:5173/*", "http://127.0.0.1:8001/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "收藏到 NavHub"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
