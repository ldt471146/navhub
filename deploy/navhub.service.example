# NavHub systemd 服务示例（部署时按需修改）
# 安装：cp navhub.service.example /etc/systemd/system/navhub.service
#       systemctl daemon-reload && systemctl enable --now navhub
[Unit]
Description=NavHub - Personal Navigation Hub with AI classification
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/navhub/server

# ===== 必填：管理员和访客密码 =====
Environment=NAVHUB_PASSWORD=change_me_admin
Environment=NAVHUB_VIEWER_PASSWORD=12345678
Environment=NAVHUB_PORT=8001

# ===== AI 聊天/分类：OpenAI 兼容接口（不填则禁用 AI 功能）=====
Environment=NAVHUB_AI_BASE_URL=https://api.deepseek.com/v1
Environment=NAVHUB_AI_MODEL=deepseek-v4-flash
Environment=NAVHUB_AI_API_KEY=sk-xxxxx

# ===== 邮箱验证码自动抓取：QQ 邮箱 IMAP（不填则禁用）=====
# QQ 邮箱 -> 设置 -> 账户 -> 开启 IMAP 服务 -> 生成授权码
Environment=NAVHUB_MAIL_USER=your@qq.com
Environment=NAVHUB_MAIL_CODE=your-imap-auth-code
Environment=NAVHUB_MAIL_INTERVAL=15

# ===== 全网搜索代理（可选，不填则禁用全局搜索）=====
Environment=NAVHUB_SEARCH_URL=https://search.diecast.cloud/api/tavily/search
Environment=NAVHUB_SEARCH_KEY=your-search-key

# ===== 天气城市坐标（open-meteo，免费无需 key）=====
Environment=NAVHUB_WEATHER_LAT=22.3193
Environment=NAVHUB_WEATHER_LON=114.1694
Environment=NAVHUB_WEATHER_CITY=香港

ExecStart=/opt/navhub/server/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
